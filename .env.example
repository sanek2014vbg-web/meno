# Environment Variables for MeNo Messenger

# --- Database ---
# Example: postgresql+asyncpg://meno_user:meno_password@db:5432/meno_db
MENO_DATABASE_URL=postgresql+asyncpg://meno_user:meno_password@db:5432/meno_db

# --- Redis ---
MENO_REDIS_URL=redis://redis:6379/0

# --- Sentry ---
MENO_SENTRY_DSN=

# --- JWT ---
MENO_JWT_SECRET=your_random_long_string_here
MENO_JWT_ALGO=HS256
MENO_JWT_EXPIRE_DAYS=30

# --- SMS Delivery ---
# Modes: "test", "telegram", "sms_ru"
MENO_SMS_MODE=test
MENO_SMS_RU_API_KEY=
MENO_SMS_RU_SENDER=MeNo
MENO_TG_BOT_TOKEN=

# --- Admin ---
MENO_ADMIN_PHONE=

# --- S3 / CDN Configuration ---
MENO_S3_BUCKET=meno-uploads
MENO_S3_ENDPOINT=
MENO_S3_ACCESS_KEY=minioadmin
MENO_S3_SECRET_KEY=minioadmin
MENO_S3_REGION=us-east-1
MENO_S3_USE_SSL=True

# --- Infrastructure ---
MENO_LOG_ACCESS=1
MENO_CORS_ORIGINS=*
MENO_FCM_SERVER_KEY=
MENO_FCM_CREDENTIALS=
