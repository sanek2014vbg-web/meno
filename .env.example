# MeNo Messenger — ШАБЛОН окружения (никаких живых ключей!).
# Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env никогда не коммитится (.gitignore + pre-commit gitleaks).

# --- Режим ---
# MENO_DEV_ENV=1 — локальная разработка: сервер сам сгенерирует одноразовый
# JWT-секрет. В ПРОДКШЕНЕ держать запрещено (Fail-Fast при MENO_ENVIRONMENT=production).
MENO_DEV_ENV=0
# production | development — при production сервер намертво отказывается
# стартовать с дефолтным/коротким/скомпрометированным JWT-секретом.
MENO_ENVIRONMENT=production

# --- Database ---
# Прод:  postgresql+asyncpg://user:pass@db:5432/meno_db
# Локально без СУБД:  sqlite+aiosqlite:///./meno.db
MENO_DATABASE_URL=postgresql+asyncpg://meno_user:CHANGE_ME@db:5432/meno_db

# --- Redis (опционален: кеши/pub/sub деградируют до in-process) ---
MENO_REDIS_URL=redis://redis:6379/0

# --- Sentry (пусто = отключено) ---
MENO_SENTRY_DSN=

# --- JWT ---
# ОБЯЗАТЕЛЬНО в проде, >= 32 символов. Сгенерируйте НОВЫЙ ключ:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MENO_JWT_SECRET=
MENO_ACCESS_TOKEN_EXPIRE_MINUTES=15
MENO_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Auth (без телефона) ---
# Регистрация по username + пароль. SMS/коды подтверждения не используются.

# --- Admin ---
MENO_ADMIN_USERNAME=owner

# --- S3 / MinIO (пустой endpoint = локальные файлы в UPLOAD_DIR) ---
MENO_S3_BUCKET=meno-uploads
MENO_S3_ENDPOINT=
MENO_S3_ACCESS_KEY=
MENO_S3_SECRET_KEY=
MENO_S3_REGION=us-east-1
MENO_S3_USE_SSL=True

# --- Infrastructure ---
MENO_LOG_ACCESS=1
# В проде перечисляйте точные origins, а не "*": https://chat.example.com
MENO_CORS_ORIGINS=
# HSTS — включить при работе по HTTPS (за nginx/traefik): max-age=1 год
MENO_HSTS_ENABLED=0
MENO_FCM_SERVER_KEY=
MENO_FCM_CREDENTIALS=
